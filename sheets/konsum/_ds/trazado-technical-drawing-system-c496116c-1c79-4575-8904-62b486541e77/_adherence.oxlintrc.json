      "--font-mono",
      "--ink",
      "--ink-faint",
      "--ink-soft",
      "--leading-body",
      "--leading-tight",
      "--line-crop",
      "--line-grid",
      "--line-hair",
      "--line-heavy",
      "--line-mid",
      "--line-thin",
      "--paper",
      "--paper-raised",
      "--pattern-brick",
      "--pattern-dots",
      "--pattern-hatch-45",
      "--pattern-hatch-cross",
      "--pattern-vertical",
      "--plan-fill",
      "--radius-0",
      "--radius-1",
      "--sheet-h",
      "--sheet-w",
      "--space-1",
      "--space-2",
      "--space-3",
