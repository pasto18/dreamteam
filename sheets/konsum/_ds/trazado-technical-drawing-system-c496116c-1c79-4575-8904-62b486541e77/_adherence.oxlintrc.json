{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/drawing/**",
              "ui_kits/sheets/**",
              "ui_kits/subardo/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Oswald|IBM Plex Mono|Caveat))/i]",
        "message": "Font not provided by the design system. Available: Oswald, IBM Plex Mono, Caveat."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|direction|leaderLength|key|ref|className|style|children)$/]",
        "message": "<AnnotationCallout> doesn't accept that prop. Declared props: text, direction, leaderLength."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationCallout'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<AnnotationCallout> direction must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DimensionLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|orientation|length|labelPosition|tone|key|ref|className|style|children)$/]",
        "message": "<DimensionLine> doesn't accept that prop. Declared props: value, orientation, length, labelPosition, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='DimensionLine'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<DimensionLine> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DimensionLine'] > JSXAttribute[name.name='labelPosition'] > Literal[value!=/^(?:inline|above)$/]",
        "message": "<DimensionLine> labelPosition must be one of 'inline' | 'above'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DimensionLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|accent)$/]",
        "message": "<DimensionLine> tone must be one of 'ink' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|pattern|fill|shape|weight|outline|key|ref|className|style|children)$/]",
        "message": "<LegendItem> doesn't accept that prop. Declared props: label, pattern, fill, shape, weight, outline."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendItem'] > JSXAttribute[name.name='pattern'] > Literal[value!=/^(?:hatch-45|hatch-cross|dots|vertical|brick)$/]",
        "message": "<LegendItem> pattern must be one of 'hatch-45' | 'hatch-cross' | 'dots' | 'vertical' | 'brick'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendItem'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|dot|line)$/]",
        "message": "<LegendItem> shape must be one of 'square' | 'dot' | 'line'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevisionStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|date|size|key|ref|className|style|children)$/]",
        "message": "<RevisionStamp> doesn't accept that prop. Declared props: label, date, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|header|footer|children|cropMarks|border|key|ref|className|style|children)$/]",
        "message": "<SheetFrame> doesn't accept that prop. Declared props: theme, header, footer, children, cropMarks, border."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetFrame'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:color|mono)$/]",
        "message": "<SheetFrame> theme must be one of 'color' | 'mono'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:project|sheetTitle|sheetNumber|date|meta|status|statusPosition|size|key|ref|className|style|children)$/]",
        "message": "<TitleBlock> doesn't accept that prop. Declared props: project, sheetTitle, sheetNumber, date, meta, status, statusPosition, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute[name.name='statusPosition'] > Literal[value!=/^(?:below|right)$/]",
        "message": "<TitleBlock> statusPosition must be one of 'below' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<TitleBlock> size must be one of 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AnnotationCallout": {
        "replaces": []
      },
      "DimensionLine": {
        "replaces": []
      },
      "LegendItem": {
